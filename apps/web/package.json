{
  "name": "lhzn-blue-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "packages": "tsc -p ../../packages/timecharts && tsc -p ../../packages/collect",
    "predev": "npm run packages",
