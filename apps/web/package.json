    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@lhzn-io/collect": "file:../../packages/collect",
    "@lhzn-io/timecharts": "file:../../packages/timecharts",
    "maplibre-gl": "5.24.0"
  }
}
